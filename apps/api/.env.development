# Local development database — keeps native dev commands off production.
#
# Same mechanism as `.env.test`: dotenv-rails loads `.env.development`
# BEFORE `.env` for the development environment and never overwrites an
# already-set key, so this DATABASE_URL wins over any (production Neon)
# DATABASE_URL sitting in `.env`. Without it, a native `bin/rails s`,
# `db:prepare`, or console with a prod URL in `.env` connects to
# production.
#
# The containerized stack is unaffected: compose.yaml sets DATABASE_URL
# as a real environment variable (host `postgres`), which takes
# precedence over every dotenv file. If your local Postgres uses a
# different user/port, override with `.env.development.local`
# (gitignored) rather than editing this shared file.
DATABASE_URL=postgresql://postgres@localhost:5432/biteworthy_dev
