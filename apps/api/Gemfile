source "https://rubygems.org"

ruby "3.3.6"

# --- Core --------------------------------------------------------------------
gem "rails", "~> 8.1.3"
gem "pg", "~> 1.5"
gem "puma", "~> 8.0"

# Solid* trio (Rails 8 defaults — no Redis, all Postgres).
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# --- API ---------------------------------------------------------------------
gem "jbuilder"
gem "rack-cors"
# Legal remediation E12 — request throttling so "don't scrape the API"
# (ToS Acceptable use) is enforced, not just stated.
gem "rack-attack"
gem "rswag-api"
gem "rswag-ui"

# --- Auth --------------------------------------------------------------------
gem "devise", "~> 5.0"
gem "devise-jwt", "~> 0.12"
gem "omniauth", "~> 2.1"
gem "omniauth-rails_csrf_protection"
gem "omniauth-google-oauth2"

# OAuth 2.1 authorization server for public MCP distribution (M8).
# Consent renders in apps/web; see docs/plans/mcp-pivot.md.
gem "doorkeeper", "~> 5.9"
gem "omniauth-apple"

# --- Storage / files ---------------------------------------------------------
gem "image_processing", "~> 2.0"
# image_processing 2.0 dropped mini_magick as a hard dependency, but
# Ingestion::DishPhotoCropper requires it directly — keep it explicit.
gem "mini_magick", "~> 5.3"
gem "aws-sdk-s3", require: false

# --- AI ingestion ------------------------------------------------------------
# We call Anthropic's REST API through Faraday rather than the official
# `anthropic` gem: app/services/anthropic_client.rb already carries our retry
# policy, prompt-cache helpers, and the `last_usage` accounting that feeds
# IngestionRun#record_api_usage!, and the job specs replay against it via VCR.
gem "faraday", "~> 2.14"
gem "faraday-retry"

# Validates Anthropic's structured-output responses against the JSON Schema
# we send up — catches model drift before the rest of the ingestion pipeline
# tries to read fields that aren't there.
gem "json-schema", "~> 6.2"

# --- MCP ---------------------------------------------------------------------
# Official Ruby SDK for Model Context Protocol servers. Backs the /mcp
# endpoint, which exposes app/tools/* to Claude Desktop / Claude Code. The
# same tool classes back the first-party chat, so domain logic and
# authorization live in one place. See docs/mcp.md.
gem "mcp", "~> 1.4"

# --- Misc utilities ----------------------------------------------------------
gem "bcrypt", "~> 3.1"
gem "bootsnap", require: false
gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails"
  gem "faker"
  gem "rswag-specs"
  gem "dotenv-rails"
end

group :development do
  gem "rubocop-rails-omakase", require: false
  gem "brakeman", require: false
end

group :test do
  gem "shoulda-matchers", "~> 8.0"
  gem "webmock"
  # Cassette-based playback for the live Anthropic calls in Phase 2.3+.
  # Cassettes are recorded locally with ANTHROPIC_API_KEY; CI replays them
  # with `record: :none`.
  gem "vcr", "~> 6.3"
end
