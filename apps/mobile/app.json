{
  "expo": {
    "name": "BiteWorthy",
    "slug": "biteworthy",
    "scheme": "biteworthy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.biteworthy.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "BiteWorthy uses your camera to scan menus and turn them into filterable, allergen-aware listings.",
        "NSPhotoLibraryUsageDescription": "BiteWorthy uses your photo library to import existing menu photos."
      }
    },
    "android": {
      "package": "app.biteworthy.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BiteWorthy uses your camera to scan menus."
        }
      ],
      "expo-secure-store",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
